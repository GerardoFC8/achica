{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // Node types are needed by test/ and scripts/, which read fixtures from
    // disk. src/ must not use them: that boundary is enforced by ESLint, not
    // by the type system, for the same reason as the core/ rule — a rule CI
    // checks beats a rule people remember.
    "types": ["vite/client", "node"]
  },
  "include": ["src", "test", "scripts", "vite.config.ts"]
}
