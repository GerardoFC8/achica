{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "achica",
  "compatibility_date": "2026-08-17",

  // No "main" field on purpose: there is no Worker script and there never
  // will be. The whole product argument is that nothing runs on a server.
  // Workers static assets serves dist/ directly and returns 404 for anything
  // that is not a file, which is the correct behaviour for a single page
  // with no client-side router.
  //
  // dist/_headers still applies here. It is parsed by the assets layer, not
  // served as an asset. The one caveat in the docs does not reach us: custom
  // headers are skipped for responses generated by Worker code, and we
  // generate none.
  "assets": {
    "directory": "./dist",
  },
}
